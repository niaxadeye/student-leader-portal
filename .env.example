APP_ENV=development
APP_NAME=student-leader-cabinet
APP_BASE_URL=https://eazytech.ru
API_BASE_URL=https://eazytech.ru

HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Порт 5433: системный PostgreSQL занимает 5432 на этом сервере
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=student_leader
POSTGRES_USER=student_leader
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=disable

JWT_ISSUER=student-leader-cabinet
JWT_AUDIENCE=student-leader-web
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

COOKIE_DOMAIN=eazytech.ru
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

PARTICIPANT_COOKIE_NAME=slc_participant_session
PARTICIPANT_SESSION_TTL=12h
PARTICIPANT_LOGIN_RATE_WINDOW=5m
PARTICIPANT_LOGIN_RATE_ATTEMPTS=10
# Используйте отдельный криптостойкий секрет. Если не задан, API временно использует JWT_REFRESH_SECRET.
PARTICIPANT_QR_SECRET=change_me_separate_qr_secret
PARTICIPANT_QR_TTL=45s

S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=3babd9c9-82a4-4c5f-b382-11f24effd682
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_USE_PATH_STYLE=true
S3_PRESIGN_TTL=15m

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_DEFAULT_THREAD_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# VK ID One Tap для входа участников. Redirect должен совпадать с настройками приложения.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URL=
# Сервисный ключ доступа приложения VK: токен пользователя привязан к его IP,
# поэтому только этим ключом сервер может вычислить id профиля по ссылке.
VK_SERVICE_TOKEN=

MAX_JSON_BODY_MB=2
DEFAULT_MAX_FILE_SIZE_MB=1024
DEFAULT_MAX_SUBMISSION_SIZE_MB=10240

LOG_LEVEL=info
OTEL_ENABLED=false
PROMETHEUS_ENABLED=true

FEATURE_REFERENCE_CMS=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_PARTICIPANT_CABINET=true
FEATURE_ATTENDANCE=true
FEATURE_POINTS=true
FEATURE_MERCH=true
FEATURE_PREDICTIONS=false
# FEATURE_JURY включает схему оценивания на испытании и кабинет /jury.
FEATURE_JURY=false

# Bootstrap superadmin — задаётся только при первом деплое, не коммитить реальные значения
BOOTSTRAP_SUPERADMIN_LOGIN=
BOOTSTRAP_SUPERADMIN_PASSWORD=
